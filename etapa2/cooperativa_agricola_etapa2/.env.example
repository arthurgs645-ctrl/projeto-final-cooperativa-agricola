# Modelo de configuracao. Copie para .env e preencha.
# O arquivo .env real NAO e versionado (ver .gitignore).
#
#   copy .env.example .env      (Windows)
#   cp   .env.example .env      (Linux/macOS)

COOP_DB_HOST=localhost
COOP_DB_PORT=3306
COOP_DB_NAME=cooperativa_agricola

# Uma conta de banco por perfil de acesso, criadas por sql/06_seguranca_perfis.sql
COOP_USER_LEITURA=app_leitura
COOP_SENHA_LEITURA=troque-aqui

COOP_USER_OPERACIONAL=app_operacional
COOP_SENHA_OPERACIONAL=troque-aqui

COOP_USER_FINANCEIRO=app_financeiro
COOP_SENHA_FINANCEIRO=troque-aqui

# Chave de assinatura da sessao do Flask
COOP_SECRET_KEY=troque-por-uma-chave-aleatoria
